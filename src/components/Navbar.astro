---
// src/components/Navbar.astro
import { SITE_CONFIG } from "../config/site";
import type { SiteTranslations } from "../i18n";

interface Props {
    t: SiteTranslations;
}

const { t } = Astro.props;
const isHindi = t.lang === "hi";
const whatsappHref = isHindi
    ? SITE_CONFIG.links.whatsappHindi
    : SITE_CONFIG.links.whatsapp;
---

<header class="site-header" id="top">
    <nav class="nav-container" aria-label="Primary Navigation">
        <a href={isHindi ? "/hi/" : "/"} class="brand-link">
            <img
                src="/images/yogawithlatika_logo_128.webp"
                alt="YogaWithLatika Logo"
                class="brand-logo"
                width="40"
                height="40"
                loading="eager"
            />
            <div class="brand-text">
                <span class="brand-name">YogaWithLatika</span>
                <span class="brand-sub">{t.nav.brandSub}</span>
            </div>
        </a>

        <div class="nav-links" role="list">
            <a href="#online-classes" class="nav-link" role="listitem">
                {t.nav.classes}
            </a>
            <a href="#reviews" class="nav-link" role="listitem">
                {t.nav.reviews}
            </a>
            <a href="#tulaa" class="nav-link" role="listitem">
                {t.nav.tulaa}
            </a>
            <a href="#youtube" class="nav-link" role="listitem">
                {t.nav.youtube}
            </a>
        </div>

        <div class="nav-actions">
            <div
                class="lang-switcher"
                role="group"
                aria-label="Language selector"
            >
                <a
                    href="/"
                    class={`lang-pill ${!isHindi ? "is-active" : ""}`}
                    data-set-lang="en"
                    lang="en"
                    aria-current={!isHindi ? "page" : undefined}
                >
                    EN
                </a>
                <a
                    href="/hi/"
                    class={`lang-pill ${isHindi ? "is-active" : ""}`}
                    data-set-lang="hi"
                    lang="hi"
                    aria-current={isHindi ? "page" : undefined}
                >
                    हिन्दी
                </a>
            </div>

            <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="nav-cta-btn"
            >
                <span>{t.nav.bookCta}</span>
            </a>
        </div>
    </nav>
</header>
