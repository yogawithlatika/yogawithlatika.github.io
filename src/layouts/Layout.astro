---
// src/layouts/Layout.astro
import "../styles/global.css";
import { GOOGLE_REVIEWS, SITE_CONFIG, getYearsOfExperience } from "../config/site";
import type { SiteTranslations } from "../i18n";

interface Props {
    t: SiteTranslations;
    image?: string;
}

const {
    t,
    image = `${SITE_CONFIG.siteUrl}/images/yogawithlatika_logo_512x512.png`,
} = Astro.props;

const isHindi = t.lang === "hi";
const canonicalUrl = isHindi
    ? `${SITE_CONFIG.siteUrl}/hi/`
    : `${SITE_CONFIG.siteUrl}/`;
const yearsExp = getYearsOfExperience();

// Load only the needed font families per locale to maximize Lighthouse speed
const googleFontsUrl = isHindi
    ? "https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Noto+Sans+Devanagari:wght@400;500;600&family=Noto+Serif+Devanagari:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    : "https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${SITE_CONFIG.siteUrl}/#website`,
            url: `${SITE_CONFIG.siteUrl}/`,
            name: SITE_CONFIG.name,
            inLanguage: ["en", "hi"],
            publisher: {
                "@id": `${SITE_CONFIG.siteUrl}/#business`,
            },
        },
        {
            "@type": "Person",
            "@id": `${SITE_CONFIG.siteUrl}/#latika`,
            name: SITE_CONFIG.therapistName,
            jobTitle: "Certified Yoga Therapist (M.Sc, B.Sc, Gold Medalist)",
            url: `${SITE_CONFIG.siteUrl}/`,
            image: `${SITE_CONFIG.siteUrl}/images/latika.png`,
            knowsLanguage: ["en", "hi", "mr"],
            knowsAbout: [
                "Yoga Therapy",
                "Prenatal Yoga",
                "PCOS & Hormonal Balance",
                "Back & Neck Pain Rehabilitation",
                "Pranayama & Stress Management",
            ],
            sameAs: [
                SITE_CONFIG.links.youtube,
                SITE_CONFIG.links.instagram,
                SITE_CONFIG.links.linkedin,
            ],
        },
        {
            "@type": "HealthAndWellnessBusiness",
            "@id": `${SITE_CONFIG.siteUrl}/#business`,
            name: SITE_CONFIG.name,
            url: canonicalUrl,
            logo: `${SITE_CONFIG.siteUrl}/images/yogawithlatika_logo_512x512.png`,
            image,
            description: t.meta.description,
            founder: {
                "@id": `${SITE_CONFIG.siteUrl}/#latika`,
            },
            foundingDate: "2014",
            areaServed: "Worldwide",
            availableLanguage: ["English", "Hindi", "Marathi"],
            priceRange: "$$",
            sameAs: [
                SITE_CONFIG.links.instagram,
                SITE_CONFIG.links.youtube,
                SITE_CONFIG.links.linkedin,
                SITE_CONFIG.links.tulaaWeb,
            ],
            aggregateRating: {
                "@type": "AggregateRating",
                ratingValue: "5.0",
                bestRating: "5",
                worstRating: "1",
                ratingCount: "50",
            },
            review: GOOGLE_REVIEWS.map((r) => ({
                "@type": "Review",
                author: {
                    "@type": "Person",
                    name: r.name,
                },
                reviewRating: {
                    "@type": "Rating",
                    ratingValue: "5",
                    bestRating: "5",
                },
                reviewBody: isHindi ? r.textHi : r.textEn,
            })),
            hasOfferCatalog: {
                "@type": "OfferCatalog",
                name: "1-on-1 Online Yoga Therapy Classes",
                itemListElement: t.onlineClasses.specialties.map((s) => ({
                    "@type": "Offer",
                    itemOffered: {
                        "@type": "Service",
                        name: s.title,
                        description: s.desc,
                    },
                })),
            },
        },
        {
            "@type": "MobileApplication",
            "@id": `${SITE_CONFIG.siteUrl}/#tulaa-app`,
            name: "Tulaa — Yoga & Private Wellness Tracker",
            operatingSystem: "Android, iOS",
            applicationCategory: "HealthApplication",
            url: SITE_CONFIG.links.tulaaWeb,
            installUrl: [
                SITE_CONFIG.links.tulaaPlayStore,
                SITE_CONFIG.links.tulaaAppStore,
            ],
            inLanguage: ["en", "hi"],
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "INR",
            },
            author: {
                "@id": `${SITE_CONFIG.siteUrl}/#latika`,
            },
        },
    ],
};
---

<!doctype html>
<html lang={t.lang} data-lang={t.lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta
            name="googlebot"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta name="theme-color" content="#FAF8F5" />
        <meta name="author" content="Latika Bissa" />
        <meta name="publisher" content="YogaWithLatika" />
        <meta name="application-name" content="YogaWithLatika" />
        <meta name="apple-mobile-web-app-title" content="YogaWithLatika" />
        <meta name="format-detection" content="telephone=no" />

        <link rel="icon" type="image/webp" href="/favicon.webp" />
        <link rel="apple-touch-icon" href="/images/yogawithlatika_logo_512x512.png" />

        <title>{t.meta.title}</title>
        <meta name="title" content={t.meta.title} />
        <meta name="description" content={t.meta.description} />
        <meta name="keywords" content={t.meta.keywords} />

        <!-- Canonical & Localization Hreflang Links -->
        <link rel="canonical" href={canonicalUrl} />
        <link
            rel="alternate"
            hreflang="en"
            href={`${SITE_CONFIG.siteUrl}/`}
        />
        <link
            rel="alternate"
            hreflang="en-IN"
            href={`${SITE_CONFIG.siteUrl}/`}
        />
        <link
            rel="alternate"
            hreflang="hi"
            href={`${SITE_CONFIG.siteUrl}/hi/`}
        />
        <link
            rel="alternate"
            hreflang="hi-IN"
            href={`${SITE_CONFIG.siteUrl}/hi/`}
        />
        <link
            rel="alternate"
            hreflang="x-default"
            href={`${SITE_CONFIG.siteUrl}/`}
        />

        <!-- OpenGraph / Facebook / WhatsApp / LinkedIn -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="YogaWithLatika" />
        <meta property="og:locale" content={t.locale} />
        <meta
            property="og:locale:alternate"
            content={isHindi ? "en_IN" : "hi_IN"}
        />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={t.meta.title} />
        <meta property="og:description" content={t.meta.description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:secure_url" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />
        <meta property="og:image:alt" content={t.meta.imageAlt} />

        <!-- Twitter / X Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={t.meta.title} />
        <meta name="twitter:description" content={t.meta.description} />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={t.meta.imageAlt} />

        <!-- Preload LCP Hero Portrait & Preconnect Critical Origins -->
        <link
            rel="preload"
            as="image"
            href="/images/latika.png"
            fetchpriority="high"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://i.ytimg.com" />

        <!-- Non-Render-Blocking Google Fonts for Optimal Lighthouse FCP/LCP -->
        <link
            rel="preload"
            as="style"
            href={googleFontsUrl}
        />
        <link
            rel="stylesheet"
            href={googleFontsUrl}
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link rel="stylesheet" href={googleFontsUrl} />
        </noscript>

        <!-- Immediate Browser Language Detection (Runs before paint) -->
        <script is:inline>
            (function () {
                try {
                    var STORAGE_KEY = "ywl_preferred_lang";
                    var savedLang = localStorage.getItem(STORAGE_KEY);
                    var path = window.location.pathname;
                    var isCurrentlyHindi =
                        path === "/hi" || path.startsWith("/hi/");

                    var targetLang = savedLang;
                    if (!targetLang) {
                        var browserLangs = navigator.languages
                            ? Array.from(navigator.languages)
                            : [navigator.language || "en"];
                        var prefersHindi = browserLangs.some(function (l) {
                            return (
                                typeof l === "string" &&
                                l.toLowerCase().startsWith("hi")
                            );
                        });
                        targetLang = prefersHindi ? "hi" : "en";
                    }

                    var hash = window.location.hash || "";
                    var search = window.location.search || "";

                    if (targetLang === "hi" && !isCurrentlyHindi) {
                        window.location.replace("/hi/" + search + hash);
                    } else if (savedLang === "en" && isCurrentlyHindi) {
                        window.location.replace("/" + search + hash);
                    }
                } catch (err) {
                    // Fail gracefully if storage is restricted
                }
            })();
        </script>

        <script
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    </head>
    <body data-build-exp={yearsExp}>
        <a href="#main-content" class="skip-link">{t.skipToContent}</a>
        <slot />

        <script>
            // 1. Language Switcher Preference Persistence
            function bindLanguageSwitcher() {
                const STORAGE_KEY = "ywl_preferred_lang";
                const langLinks =
                    document.querySelectorAll<HTMLAnchorElement>(
                        "[data-set-lang]",
                    );
                langLinks.forEach((link) => {
                    link.addEventListener("click", () => {
                        const chosen = link.getAttribute("data-set-lang");
                        if (chosen) {
                            try {
                                localStorage.setItem(STORAGE_KEY, chosen);
                            } catch {
                                // Ignore storage errors
                            }
                        }
                    });
                });
            }

            // 2. Dynamic Experience Counter from 2014 (Future-proof across years)
            function syncExperienceYears() {
                const START_YEAR = 2014;
                const liveYears = Math.max(
                    12,
                    new Date().getFullYear() - START_YEAR,
                );

                document
                    .querySelectorAll<HTMLElement>("[data-exp-stat]")
                    .forEach((el) => {
                        const lang = el.getAttribute("data-exp-stat");
                        el.textContent =
                            lang === "hi"
                                ? `${liveYears}+ वर्ष`
                                : `${liveYears}+ Yrs`;
                    });

                document
                    .querySelectorAll<HTMLElement>("[data-exp-therapy-sub]")
                    .forEach((el) => {
                        const lang = el.getAttribute("data-exp-therapy-sub");
                        el.textContent =
                            lang === "hi"
                                ? `2014 से ${liveYears}+ वर्षों के अनुभव के साथ, हर क्लास आपके शरीर की क्षमता, स्वास्थ्य समस्या और सुविधाजनक समय के अनुसार कराई जाती है।`
                                : `With ${liveYears}+ years of experience since 2014, every class is 100% customized to your body, health goals, and comfort level.`;
                    });

                document
                    .querySelectorAll<HTMLElement>("[data-exp-tulaa]")
                    .forEach((el) => {
                        const lang = el.getAttribute("data-exp-tulaa");
                        el.textContent =
                            lang === "hi"
                                ? `${liveYears}+ वर्षों के अनुभव वाली योग विशेषज्ञ लतिका बिस्सा द्वारा तैयार रूटीन।`
                                : `Curated by Latika Bissa (${liveYears}+ years yoga therapy experience) for all skill levels.`;
                    });
            }

            // 3. Soft Reveal-on-Scroll Observer
            function initScrollReveal() {
                const revealTargets =
                    document.querySelectorAll(".reveal-on-scroll");
                if (!("IntersectionObserver" in window)) {
                    revealTargets.forEach((el) =>
                        el.classList.add("is-visible"),
                    );
                    return;
                }

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        root: null,
                        threshold: 0.08,
                        rootMargin: "0px 0px -40px 0px",
                    },
                );

                revealTargets.forEach((el) => observer.observe(el));
            }

            // 4. Subtle Mobile Haptic Feedback
            function initGentleHaptics() {
                const interactive = document.querySelectorAll(
                    ".btn, .store-badge-btn, .lang-pill, .pillar-summary-card, .yt-video-card",
                );
                interactive.forEach((el) => {
                    el.addEventListener("click", () => {
                        if ("vibrate" in navigator) {
                            navigator.vibrate(8);
                        }
                    });
                });
            }

            function initAll() {
                bindLanguageSwitcher();
                syncExperienceYears();
                initScrollReveal();
                initGentleHaptics();
            }

            initAll();
            document.addEventListener("astro:page-load", initAll);
        </script>
    </body>
</html>
